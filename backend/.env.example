# Copy to .env before `docker compose up` -- compose reads this
# automatically. Every value here is required (docker-compose.yml uses
# ${VAR:?...} so it refuses to start with any of these unset).

# Password for the seeded admin user (admin@alyssum.example, tenant "alyssum").
ADMIN_PASSWORD=

# Signs every session JWT (auth-service, tenant-service, rbac-service,
# query-gateway all need the same value). Generate with:
#   openssl rand -hex 32
JWT_SECRET=

# Shared secret ingest-gateway/other internal callers use to hit
# tenant-service's unauthenticated (no user session) namespace-report
# endpoint. Generate the same way as JWT_SECRET.
INTERNAL_API_KEY=
