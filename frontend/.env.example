# Infra Cost section (Overview page) -- src/app/api/costs/route.ts
#
# Each provider is independent: set only the ones you have. Any provider
# left unconfigured shows as "Not connected" in the UI instead of an error.
# None of these are ever sent to the browser -- they're only read
# server-side, inside the Next.js API route.

# ---- AWS (Cost Explorer) ----
# IAM user/role needs the ce:GetCostAndUsage permission.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=   # alternative to the two keys above, if using a shared credentials file

# ---- GCP (BigQuery billing export) ----
# GCP has no direct "current spend" API. You must first enable detailed
# billing export to BigQuery yourself (one-time, in the GCP console):
# https://cloud.google.com/billing/docs/how-to/export-data-bigquery
# Then point these at that exported table.
GOOGLE_APPLICATION_CREDENTIALS=            # path to a service account JSON key file
# GCP_SERVICE_ACCOUNT_JSON=                # ...or the key JSON inline, for serverless hosts without a filesystem
GCP_BILLING_PROJECT_ID=
GCP_BILLING_DATASET=
GCP_BILLING_TABLE=                         # e.g. gcp_billing_export_v1_XXXXXX_XXXXXX_XXXXXX

# ---- Azure (Cost Management) ----
# App registration needs Cost Management Reader on the subscription.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=

# ---- Scaleway (Billing API) ----
# IAM API key needs billing read access.
SCALEWAY_SECRET_KEY=
SCALEWAY_ORGANIZATION_ID=

# Observex backend (Go services under /backend) -- auth, tenants/clusters,
# RBAC, and the query-gateway that proxies Mimir/Loki/Tempo. All four are
# read server-side only, inside Next.js Route Handlers -- never sent to the
# browser. Defaults below match docker-compose's exposed ports, so a local
# `docker compose up` in backend/ needs no .env.local changes at all; only
# override these if a service is hosted somewhere else.
AUTH_SERVICE_URL=http://localhost:8081     # login/logout/session (POST /login sets the observex_session cookie)
TENANT_SERVICE_URL=http://localhost:8082   # clusters + namespaces (admin pages)
RBAC_SERVICE_URL=http://localhost:8083     # users + access grants (admin pages)
QUERY_GATEWAY_URL=http://localhost:8085    # metrics/logs/traces/alerts read path, RBAC-enforced per request
BLACKBOX_SERVICE_URL=http://localhost:8088 # uptime/synthetic checks (Uptime page)

# Public URL of the ingest-gateway that a cluster-agent's Helm install should
# point at -- baked into the client bundle at build time (NEXT_PUBLIC_*), so
# it's safe to be world-readable. Left empty, the Connect Cluster page shows
# a placeholder in the Helm command instead of emitting "undefined".
NEXT_PUBLIC_INGEST_GATEWAY_URL=
